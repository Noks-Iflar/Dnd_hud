<div class="kh-root" lang="ru">
{{#if actor}}
  <div class="kh-left">

    {{!-- Портрет: прямоугольный, в рамке initiative-frame; клик — лист персонажа --}}
    <div class="kh-portrait-col">
      <button type="button" class="kh-portrait {{#if concentrating}}is-concentrating{{/if}}" data-action="openSheet" data-tooltip="Открыть лист персонажа" aria-label="Открыть лист персонажа">
        <img class="kh-portrait-img" src="{{img}}" alt="">
        <span class="kh-portrait-frame"></span>
      </button>
      {{#if concentrating}}
      <img class="kh-conc-badge" src="{{assets}}/status-concentration.png" alt="" data-tooltip="Концентрация">
      {{/if}}
      {{#if inspiration.show}}
      <button type="button" class="kh-inspiration {{#if inspiration.on}}is-on{{/if}}" data-action="toggleInspiration" data-tooltip="{{#if inspiration.on}}Героическое вдохновение есть (клик — потратить){{else}}Нет героического вдохновения (клик — получить){{/if}}" aria-label="Героическое вдохновение" aria-pressed="{{inspiration.on}}">★</button>
      {{/if}}
      <div class="kh-name">{{name}}</div>
    </div>

    {{!-- Сфера здоровья заходит на край портрета; при 0 ПЗ у персонажа — спасброски от смерти --}}
    <div class="kh-orb {{#if khvor}}is-khvor{{/if}} {{#if death}}is-dying{{/if}}" data-tooltip="Здоровье: {{hp.value}} из {{hp.max}}">
      <div class="kh-orb-glass">
        <div class="kh-orb-empty"></div>
        <div class="kh-orb-blood" style="clip-path: inset({{hp.missing}}% 0 0 0)"></div>
        {{#if death}}
        <button type="button" class="kh-death" data-action="rollDeathSave" data-tooltip="Спасбросок от смерти" aria-label="Спасбросок от смерти: успехов {{death.successes}}, провалов {{death.failures}}">
          <span class="kh-death-row is-success">{{#each death.success}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
          <span class="kh-death-label">Смерть</span>
          <span class="kh-death-row is-failure">{{#each death.failure}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
        </button>
        {{else}}
        <div class="kh-orb-text">
          <span class="kh-hp">{{hp.value}}</span>
          <span class="kh-hp-max">из {{hp.max}}</span>
        </div>
        {{/if}}
      </div>
      <div class="kh-orb-frame"></div>
      {{#if hp.temp}}<div class="kh-temp" data-tooltip="Временные ПЗ">+{{hp.temp}}</div>{{/if}}
    </div>

    {{!-- Левая панель в три столбца: щит КБ | скорость, СЛ, инициатива | кнопки 2 × 2 --}}
    <div class="kh-panel">
      {{!-- Ряд эффектов над панелью: концентрация плашкой, остальное иконками; крестик — снять --}}
      {{#if effects.show}}
      <div class="kh-effects">
        {{#each effects.concentration}}
        <div class="kh-conc-plaque" data-tooltip="Концентрация: {{name}}">
          <img src="{{@root.assets}}/status-concentration.png" alt="">
          <span class="kh-conc-name">{{name}}</span>
          {{#if rounds}}<span class="kh-conc-rounds">{{rounds}} р.</span>{{/if}}
          {{#if @root.effects.canRemove}}
          <button type="button" class="kh-x" data-action="removeEffect" data-uuid="{{uuid}}" data-conc="1" data-tooltip="Прервать концентрацию" aria-label="Прервать концентрацию">×</button>
          {{/if}}
        </div>
        {{/each}}
        {{#each effects.list}}
        <div class="kh-effect" data-tooltip="{{tooltip}}">
          <img src="{{img}}" alt="">
          {{#if rounds}}<span class="kh-effect-rounds">{{rounds}}</span>{{/if}}
          {{#if @root.effects.canRemove}}
          <button type="button" class="kh-x" data-action="removeEffect" data-uuid="{{uuid}}" data-tooltip="Снять: {{name}}" aria-label="Снять: {{name}}">×</button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      <div class="kh-ac" data-tooltip="Класс брони">
        <span class="kh-ac-value">{{ac}}</span>
        <span class="kh-ac-label">КБ</span>
      </div>
      <div class="kh-stats">
        <div class="kh-move" data-tooltip="{{#if move.tracked}}Движение в этот ход: осталось {{move.left}} из {{move.total}} {{units}}{{else}}Скорость{{/if}}">
          <span class="kh-move-value">{{#if move.tracked}}{{move.left}}<small>/{{move.total}}</small>{{else}}{{move.total}}{{/if}} <small>{{units}}</small></span>
          <span class="kh-move-bar">{{#each move.segments}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
        </div>
        <div class="kh-stat" data-tooltip="{{extra.label}}">
          <span class="kh-stat-value">{{extra.value}}</span>
          <span class="kh-stat-label">{{extra.short}}</span>
        </div>
        <div class="kh-stat" data-tooltip="Инициатива">
          <span class="kh-stat-value">{{init}}</span>
          <span class="kh-stat-label">иниц.</span>
        </div>
        {{#if legres}}
        {{!-- Легендарное сопротивление NPC: горит — есть; клик по горящему — использовать, по пустому — вернуть --}}
        <div class="kh-legres" data-tooltip="Легендарное сопротивление: {{legres.value}} из {{legres.max}}">
          <span class="kh-stat-label">сопр.</span>
          {{#each legres.gems}}
          <button type="button" class="kh-res-gem" data-action="useResistance" data-on="{{#if this}}1{{/if}}" aria-label="{{#if this}}Использовать сопротивление{{else}}Вернуть сопротивление{{/if}}">
            <img src="{{@root.assets}}/{{#if this}}gem-action{{else}}gem-socket-empty{{/if}}.png" alt="">
          </button>
          {{/each}}
        </div>
        {{/if}}
      </div>
      <div class="kh-panel-btns">
        <button type="button" class="kh-icon-btn" data-action="rollInitiative" data-tooltip="Бросить инициативу" aria-label="Бросить инициативу">
          <img src="{{assets}}/icon-initiative.png" alt="">
        </button>
        <button type="button" class="kh-icon-btn" data-action="openSkills" data-tooltip="Навыки и проверки" aria-label="Навыки и проверки">
          <img src="{{assets}}/icon-skills.png" alt="">
        </button>
        {{#if canRest}}
        <button type="button" class="kh-icon-btn" data-action="shortRest" data-tooltip="Короткий отдых" aria-label="Короткий отдых">
          <img src="{{assets}}/icon-short-rest.png" alt="">
        </button>
        <button type="button" class="kh-icon-btn" data-action="longRest" data-tooltip="Долгий отдых" aria-label="Долгий отдых">
          <img src="{{assets}}/icon-long-rest.png" alt="">
        </button>
        {{/if}}
      </div>
    </div>
  </div>

  {{!-- Способности: вкладки и страницы сверху, ниже группы по типу действия с подписью и ромбом --}}
  <div class="kh-center {{#if panel.tall}}is-tall{{/if}}">
    <img class="kh-crest" src="{{assets}}/panel-crest.png" alt="">
    {{!-- Подсказка способности: заполняется скриптом при наведении на плитку --}}
    <div class="kh-tip" role="tooltip" hidden></div>

    <div class="kh-bar">
      <div class="kh-tabs" role="tablist" aria-label="Фильтр способностей">
        {{#each panel.tabs}}
        <button type="button" class="kh-tab {{#if active}}active{{/if}}" role="tab" aria-selected="{{active}}" data-action="setTab" data-tab="{{id}}">{{label}}</button>
        {{/each}}
      </div>
      {{#if legact}}
      {{!-- Легендарные действия NPC: горит — есть; клик по горящему — потратить, по пустому — вернуть --}}
      <div class="kh-slots kh-legact" data-tooltip="Легендарные действия: {{legact.value}} из {{legact.max}}">
        <span class="kh-slot-row">
          <span class="kh-slot-label kh-legact-label">Легендарные</span>
          {{#each legact.gems}}
          <button type="button" class="kh-res-gem" data-action="spendLegendary" data-on="{{#if this}}1{{/if}}" aria-label="{{#if this}}Потратить легендарное действие{{else}}Вернуть легендарное действие{{/if}}">
            <img src="{{@root.assets}}/{{#if this}}gem-action{{else}}gem-socket-empty{{/if}}.png" alt="">
          </button>
          {{/each}}
        </span>
      </div>
      {{/if}}
      {{#if slots.length}}
      {{!-- Ячейки заклинаний: горит — есть, пустое гнездо — потрачено; договор отдельно --}}
      <div class="kh-slots">
        {{#each slots}}
        <span class="kh-slot-row {{#if pact}}is-pact{{/if}}" data-tooltip="{{title}}">
          <span class="kh-slot-label">{{label}}</span>
          {{#each gems}}<img src="{{@root.assets}}/{{#if this}}{{#if ../pact}}gem-pact{{else}}gem-slot{{/if}}{{else}}gem-socket-empty{{/if}}.png" alt="">{{/each}}
        </span>
        {{/each}}
      </div>
      {{/if}}
      <div class="kh-pager">
        {{#if panel.multi}}
        <button type="button" class="kh-page-btn" data-action="prevPage" data-tooltip="Предыдущая страница" aria-label="Предыдущая страница" {{#unless panel.hasPrev}}disabled{{/unless}}>‹</button>
        <span class="kh-page-num">{{panel.pageLabel}}</span>
        <button type="button" class="kh-page-btn" data-action="nextPage" data-tooltip="Следующая страница" aria-label="Следующая страница" {{#unless panel.hasNext}}disabled{{/unless}}>›</button>
        {{/if}}
        <button type="button" class="kh-page-btn kh-rows-btn {{#if panel.tall}}active{{/if}}" data-action="toggleRows" data-tooltip="{{#if panel.tall}}Одна строка{{else}}Две строки{{/if}}" aria-label="{{#if panel.tall}}Одна строка{{else}}Две строки{{/if}}" aria-pressed="{{panel.tall}}"><i class="fa-solid {{#if panel.tall}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i></button>
      </div>
    </div>

    <div class="kh-groups">
      {{#each panel.groups}}
      <div class="kh-group kh-group-{{key}} {{#if stub}}is-stub{{/if}} {{#if active}}is-active{{/if}} {{#if spent}}is-economy-spent{{/if}}">
        {{#unless stub}}
        <div class="kh-group-body">
          <div class="kh-tiles" style="--cols: {{cols}}">
            {{#each tiles}}
            <button type="button" class="kh-tile {{#if spent}}is-spent{{/if}}" data-action="useAbility" data-item-id="{{itemId}}" data-activity-id="{{activityId}}" aria-label="{{name}}{{#if badge}} ({{badge}}){{/if}}">
              <span class="kh-tile-slot">
                <img class="kh-tile-img" src="{{img}}" alt="">
                {{#if badge}}<span class="kh-badge {{#if recharge}}is-recharge{{/if}} {{#if level}}is-level{{/if}} {{#if pact}}is-pact{{/if}}">{{badge}}</span>{{/if}}
                {{#if quantity}}<span class="kh-badge">{{quantity}}</span>{{/if}}
                {{#if cost}}<span class="kh-cost">{{#each cost}}<i></i>{{/each}}</span>{{/if}}
              </span>
              <span class="kh-tile-name">{{label}}</span>
            </button>
            {{/each}}
          </div>
        </div>
        {{/unless}}
        {{!-- Подпись группы: ромб — экономия действий (в бою гаснет, когда потрачено; клик — вручную),
             название — фильтр (клик оставляет только эту группу, повторный клик — все) --}}
        <div class="kh-group-label">
          {{#if gem}}
          {{#if @root.inCombat}}
          <button type="button" class="kh-gem {{#if spent}}is-spent{{/if}}" data-action="toggleEconomy" data-key="{{key}}" data-tooltip="{{#if spent}}{{label}}: потрачено (клик — вернуть){{else}}{{label}}: доступно (клик — отметить потраченным){{/if}}" aria-label="{{label}}: {{#if spent}}потрачено{{else}}доступно{{/if}}">
            <img src="{{@root.assets}}/{{#if spent}}gem-socket-empty{{else}}{{gem}}{{/if}}.png" alt="">
          </button>
          {{else}}
          <img class="kh-gem-static" src="{{@root.assets}}/{{gem}}.png" alt="">
          {{/if}}
          {{/if}}
          <button type="button" class="kh-group-filter" data-action="setGroup" data-group="{{key}}" aria-pressed="{{active}}" data-tooltip="{{#if active}}Показать все группы{{else}}Только «{{label}}»{{/if}}">{{label}}</button>
        </div>
      </div>
      {{else}}
      <div class="kh-empty">Нет способностей</div>
      {{/each}}
    </div>
  </div>

  {{!-- Правый блок: режим броска, базовые действия, «Завершить ход» (только в бою) --}}
  <div class="kh-right">
    <div class="kh-seg" role="group" aria-label="Режим броска">
      {{#each modes}}
      <button type="button" class="kh-seg-btn {{cls}} {{#if active}}active{{/if}}" data-action="setRollMode" data-mode="{{id}}" data-tooltip="{{hint}}" aria-pressed="{{active}}">{{label}}</button>
      {{/each}}
    </div>
    {{#if visibility}}
    {{!-- Только ГМу: броски всем или скрыто (режим бросков Foundry) --}}
    <div class="kh-seg kh-seg-visibility" role="group" aria-label="Кто видит броски">
      {{#each visibility}}
      <button type="button" class="kh-seg-btn {{#if active}}active{{/if}}" data-action="setVisibility" data-mode="{{mode}}" data-tooltip="{{hint}}" aria-pressed="{{active}}">{{label}}</button>
      {{/each}}
    </div>
    {{/if}}
    <div class="kh-basic" role="group" aria-label="Базовые действия">
      {{#each basic}}
      <button type="button" class="kh-basic-btn {{#if active}}is-active{{/if}}" data-action="basicAction" data-basic="{{id}}" data-tooltip="{{label}}{{#if active}} — активно, клик снимет{{/if}}" aria-label="{{label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
        <img src="{{@root.assets}}/{{icon}}.png" alt="">
      </button>
      {{/each}}
    </div>
    {{#if endTurn.show}}
    <button type="button" class="kh-end-turn {{#unless endTurn.active}}is-waiting{{/unless}}" data-action="endTurn" {{#unless endTurn.active}}disabled{{/unless}} data-tooltip="{{endTurn.hint}}">
      <span>Завершить ход</span>
    </button>
    {{/if}}
  </div>
{{/if}}
</div>
